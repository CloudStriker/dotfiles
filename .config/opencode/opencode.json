{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer {file:~/.secrets/context7_key}"
      }
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "Authorization": "Bearer {file:~/.secrets/exa_key}"
      }
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp-oauth"
    },
    "arxiv": {
      "type": "local",
      "command": [
        "uvx",
        "arxiv-mcp-server"
      ]
    },
    "mineru": {
      "type": "local",
      "command": [
        "docker", "run", "--rm", "-i",
        "--user", "1000:1000",
        "-e", "HOME=/tmp",
        "-e", "PYTHONUNBUFFERED=1",
        "-e", "MINERU_API_TOKEN",
        "-e", "OUTPUT_DIR={env:HOME}/mineru-downloads",
        "-v", "{env:HOME}/docs-in:{env:HOME}/docs-in:ro",
        "-v", "{env:HOME}/mineru-downloads:{env:HOME}/mineru-downloads",
        "ghcr.io/astral-sh/uv:python3.12-bookworm-slim",
        "uvx", "mineru-open-mcp"
      ],
      "environment": {
        "MINERU_API_TOKEN": "{file:~/.secrets/mineru_token}"
      }
    }
  },
  "instructions": [
    "~/.config/opencode/rules/workflow-rules.md"
  ],
  "permissions": [
    {
      "action": "read",
      "resource": "*.secrets/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.secrets/*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*.secrets*",
      "effect": "deny"
    },
    {
      "action": "experimental_image_generate",
      "resource": "*",
      "effect": "deny"
    }
  ]
}